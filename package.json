{
  "name": "caelus-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc -b && tsc -p examples/browser && tsc -p examples/desktop",
    "browser": "npm run build && npm run dev -w examples/browser",
    "desktop": "npm run build && npm run electron -w examples/desktop",
    "pretest": "npm run build && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
