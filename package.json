{
  "name": "@ufo-soft/caelus",
  "version": "0.1.0",
  "description": "A command registry: define a command once, dispatch it from any surface.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ufo-soft/caelus.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/core.js",
  "types": "./dist/core.d.ts",
  "exports": {
    ".": "./dist/core.js",
    "./keybindings": "./dist/keybindings.js"
  },
  "files": [
    "dist"
  ],
  "workspaces": [
    "example"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc && npm run dev -w example",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "smol-toml": "^1.9.1"
  }
}
